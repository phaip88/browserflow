# Copy to .env. Never commit .env or secrets/.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
POSTGRES_PASSWORD=change-me-strong-password
NODE_ENV=production
BROWSERFLOW_BIND_HOST=127.0.0.1
BROWSERFLOW_AUTH_MODE=authenticated            # local-only permitted ONLY with BIND_HOST=127.0.0.1
BROWSERFLOW_MASTER_KEY_FILE=./secrets/master.key   # 32 random bytes, base64: openssl rand -base64 32 > secrets/master.key
BROWSERFLOW_DATA_DIR=./data
BROWSERFLOW_RUNTIME_DIR=./runtime
BROWSERFLOW_BROWSER_CONCURRENCY=1              # 1 (default) or 2
BROWSERFLOW_FLOW_TIMEOUT_MS=900000
BROWSERFLOW_NODE_TIMEOUT_MS=30000
BROWSERFLOW_MAX_LOOP_ITERATIONS=1000
BROWSERFLOW_MAX_PAGES=5
BROWSERFLOW_MAX_ARTIFACT_BYTES=26214400
BROWSERFLOW_MAX_TOTAL_ARTIFACT_BYTES=10737418240
BROWSERFLOW_RETENTION_DAYS=30
BROWSERFLOW_HEARTBEAT_INTERVAL_MS=5000
BROWSERFLOW_LEASE_TTL_MS=30000
BROWSERFLOW_GRACEFUL_SHUTDOWN_MS=30000
BROWSERFLOW_NETWORK_PRIVATE_ALLOWLIST=         # e.g. 127.0.0.1 or 10.1.2.0/24 (dangerous; warns at startup)
BROWSERFLOW_AI_PROVIDER=disabled               # 'fake' is test-only and refused in production
BROWSERFLOW_EMBEDDED_SUPERVISOR=true           # false in Docker Compose (dedicated services)
BROWSERFLOW_LOG_LEVEL=info
