# BrowserFlow configuration — copy to .env and fill in values.
# Never commit .env or key files.

# --- Runtime ---
BROWSERFLOW_ENV=development
BROWSERFLOW_LOG_LEVEL=INFO
BROWSERFLOW_SERVICE_NAME=api
BROWSERFLOW_BIND_HOST=127.0.0.1
BROWSERFLOW_API_PORT=8000
BROWSERFLOW_PUBLIC_BASE_URL=http://127.0.0.1:8000
BROWSERFLOW_WEB_ORIGIN=http://127.0.0.1:5173
BROWSERFLOW_LOCALE=en
BROWSERFLOW_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Authentication. local-only unauthenticated mode is allowed ONLY when
# BROWSERFLOW_BIND_HOST is 127.0.0.1 AND this flag is explicitly true.
BROWSERFLOW_AUTH_MODE=authenticated
BROWSERFLOW_ALLOW_LOCAL_UNAUTHENTICATED=false
BROWSERFLOW_SESSION_COOKIE_NAME=bf_session
BROWSERFLOW_SESSION_TTL_SECONDS=43200
BROWSERFLOW_SESSION_SECURE_COOKIE=false
BROWSERFLOW_CSRF_COOKIE_NAME=bf_csrf
BROWSERFLOW_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Secrets — load from files, never from the repo.
BROWSERFLOW_MASTER_KEY_FILE=./secrets/master.key
BROWSERFLOW_SESSION_SECRET_FILE=./secrets/session.secret

# --- Database (PostgreSQL is the only supported store) ---
POSTGRES_PASSWORD=browserflow_dev
BROWSERFLOW_DATABASE_URL=postgresql+asyncpg://browserflow:browserflow_dev@127.0.0.1:5432/browserflow
BROWSERFLOW_DATABASE_URL_SYNC=postgresql://browserflow:browserflow_dev@127.0.0.1:5432/browserflow

# --- Redis (optional accelerator; system remains correct without it) ---
BROWSERFLOW_REDIS_URL=redis://127.0.0.1:6379/0
BROWSERFLOW_REDIS_OPTIONAL=true

# --- Worker / browser ---
BROWSERFLOW_WORKER_ID=
BROWSERFLOW_WORKER_CAPACITY=1
BROWSERFLOW_MAX_BROWSER_CONCURRENCY=1
BROWSERFLOW_HEARTBEAT_INTERVAL_SECONDS=5
BROWSERFLOW_LEASE_TTL_SECONDS=30
BROWSERFLOW_WORKER_POLL_INTERVAL_SECONDS=2
BROWSERFLOW_PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=true

# --- Limits ---
BROWSERFLOW_FLOW_TIMEOUT_SECONDS=600
BROWSERFLOW_NODE_TIMEOUT_SECONDS=60
BROWSERFLOW_MAX_FOREACH_ITERATIONS=1000
BROWSERFLOW_MAX_PAGES=8
BROWSERFLOW_MAX_DOWNLOAD_BYTES=52428800
BROWSERFLOW_MAX_ARTIFACT_BYTES=104857600
BROWSERFLOW_MAX_TOTAL_STORAGE_BYTES=10737418240
BROWSERFLOW_SCREENSHOT_INTERVAL_SECONDS=4
BROWSERFLOW_SCREENSHOT_MAX_WIDTH=1280
BROWSERFLOW_ARTIFACT_RETENTION_DAYS=14
BROWSERFLOW_EVENT_RETENTION_DAYS=30

# --- Paths ---
BROWSERFLOW_DATA_DIR=./data
BROWSERFLOW_RUNTIME_DIR=./runtime
BROWSERFLOW_ARTIFACT_DIR=./data/artifacts

# --- Observability ---
BROWSERFLOW_OTEL_EXPORTER_OTLP_ENDPOINT=
BROWSERFLOW_OTEL_ENABLED=false
BROWSERFLOW_METRICS_ENABLED=true

# --- Network policy ---
BROWSERFLOW_ALLOW_PRIVATE_NETWORK=false
BROWSERFLOW_PRIVATE_NETWORK_ALLOWLIST=

# --- AI (Release 1: disabled only; fake is test-only and fails in production) ---
BROWSERFLOW_AI_PROVIDER=disabled
